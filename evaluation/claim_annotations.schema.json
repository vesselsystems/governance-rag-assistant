{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/governance-rag/claim-annotations-v1.schema.json",
  "title": "Governance RAG claim-level evidence annotations",
  "description": "A contract for human review. Null labels and pending evidence references are unresolved and are not measured as failures or passes.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "review_status", "reviewer", "fixture_binding", "cases"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "review_status": {
      "enum": ["pending_human_review", "partially_reviewed", "reviewed"]
    },
    "reviewer": {"$ref": "#/$defs/reviewer"},
    "fixture_binding": {"$ref": "#/$defs/fixture_binding"},
    "cases": {
      "type": "array",
      "items": {"$ref": "#/$defs/case"}
    },
    "notes": {"type": ["string", "null"]}
  },
  "allOf": [
    {
      "if": {"properties": {"review_status": {"const": "pending_human_review"}}},
      "then": {
        "properties": {
          "reviewer": {
            "properties": {
              "id": {"type": "null"},
              "status": {"const": "pending_human_review"}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"review_status": {"const": "partially_reviewed"}}},
      "then": {
        "properties": {
          "reviewer": {
            "properties": {
              "id": {"$ref": "#/$defs/non_blank_string"},
              "status": {"const": "partially_reviewed"}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"review_status": {"const": "reviewed"}}},
      "then": {
        "properties": {
          "reviewer": {
            "properties": {
              "id": {"$ref": "#/$defs/non_blank_string"},
              "status": {"const": "reviewed"}
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "non_blank_string": {
      "type": "string",
      "pattern": "\\S"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{64}$"
    },
    "fixture_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixture_file", "algorithm"],
      "properties": {
        "fixture_file": {"$ref": "#/$defs/non_blank_string"},
        "algorithm": {"const": "sha256-canonical-json-v1"}
      }
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status"],
      "properties": {
        "id": {
          "type": ["string", "null"],
          "pattern": "\\S"
        },
        "status": {
          "enum": ["pending_human_review", "partially_reviewed", "reviewed"]
        }
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "pending_human_review"}}},
          "then": {"properties": {"id": {"type": "null"}}}
        },
        {
          "if": {"properties": {"status": {"enum": ["partially_reviewed", "reviewed"]}}},
          "then": {"properties": {"id": {"$ref": "#/$defs/non_blank_string"}}}
        }
      ]
    },
    "label": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "status"],
      "properties": {
        "label": {"type": ["string", "null"]},
        "status": {"enum": ["pending_human_review", "reviewed"]},
        "reviewer_id": {
          "type": ["string", "null"],
          "pattern": "\\S"
        },
        "notes": {"type": ["string", "null"]}
      },
      "allOf": [
        {
          "if": {"properties": {"label": {"type": "null"}}},
          "then": {
            "properties": {
              "status": {"const": "pending_human_review"},
              "reviewer_id": {"type": "null"}
            }
          }
        },
        {
          "if": {"properties": {"label": {"type": "string"}}},
          "then": {
            "required": ["reviewer_id"],
            "properties": {
              "status": {"const": "reviewed"},
              "reviewer_id": {"$ref": "#/$defs/non_blank_string"}
            }
          }
        }
      ]
    },
    "evidence_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["citation", "source", "chunk_id", "status"],
      "properties": {
        "citation": {
          "type": "string",
          "pattern": "^\\[[^\\]\\[#\\r\\n]+#[^\\]\\[#\\r\\n]+\\]$"
        },
        "source": {"$ref": "#/$defs/non_blank_string"},
        "chunk_id": {"$ref": "#/$defs/non_blank_string"},
        "status": {"enum": ["pending_human_review", "reviewed"]},
        "reviewer_id": {
          "type": ["string", "null"],
          "pattern": "\\S"
        },
        "notes": {"type": ["string", "null"]}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "pending_human_review"}}},
          "then": {"properties": {"reviewer_id": {"type": "null"}}}
        },
        {
          "if": {"properties": {"status": {"const": "reviewed"}}},
          "then": {
            "required": ["reviewer_id"],
            "properties": {"reviewer_id": {"$ref": "#/$defs/non_blank_string"}}
          }
        }
      ]
    },
    "claim_support": {
      "allOf": [
        {"$ref": "#/$defs/label"},
        {
          "properties": {
            "label": {
              "enum": ["supported", "partially_supported", "unsupported", "not_applicable", null]
            }
          }
        }
      ]
    },
    "citation_completeness": {
      "allOf": [
        {"$ref": "#/$defs/label"},
        {
          "properties": {
            "label": {"enum": ["complete", "incomplete", "not_applicable", null]}
          }
        }
      ]
    },
    "citation_precision": {
      "allOf": [
        {"$ref": "#/$defs/label"},
        {
          "properties": {
            "label": {"enum": ["precise", "imprecise", "incorrect", "not_applicable", null]}
          }
        }
      ]
    },
    "unsupported_claim": {
      "allOf": [
        {"$ref": "#/$defs/label"},
        {
          "properties": {
            "label": {"enum": ["yes", "no", "not_applicable", null]}
          }
        }
      ]
    },
    "abstention_correctness": {
      "allOf": [
        {"$ref": "#/$defs/label"},
        {
          "properties": {
            "label": {"enum": ["correct", "incorrect", "not_applicable", null]}
          }
        }
      ]
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "claim_text",
        "claim_support",
        "citation_completeness",
        "citation_precision",
        "unsupported_claim",
        "evidence_references"
      ],
      "properties": {
        "claim_id": {"$ref": "#/$defs/non_blank_string"},
        "claim_text": {"$ref": "#/$defs/non_blank_string"},
        "claim_support": {"$ref": "#/$defs/claim_support"},
        "citation_completeness": {"$ref": "#/$defs/citation_completeness"},
        "citation_precision": {"$ref": "#/$defs/citation_precision"},
        "unsupported_claim": {"$ref": "#/$defs/unsupported_claim"},
        "evidence_references": {
          "type": "array",
          "items": {"$ref": "#/$defs/evidence_reference"}
        },
        "notes": {"type": ["string", "null"]}
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id",
        "split",
        "case_type",
        "question",
        "answer",
        "review_scope",
        "fixture_sha256",
        "abstention_correctness",
        "claims"
      ],
      "properties": {
        "case_id": {"$ref": "#/$defs/non_blank_string"},
        "split": {"$ref": "#/$defs/non_blank_string"},
        "case_type": {
          "enum": ["answerable", "unanswerable", "adversarial", "ambiguous"]
        },
        "question": {"$ref": "#/$defs/non_blank_string"},
        "answer": {"type": ["string", "null"]},
        "review_scope": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["claim_support", "citation_completeness", "citation_precision", "unsupported_claim", "abstention_correctness"]}
        },
        "fixture_sha256": {"$ref": "#/$defs/sha256"},
        "abstention_correctness": {"$ref": "#/$defs/abstention_correctness"},
        "claims": {
          "type": "array",
          "items": {"$ref": "#/$defs/claim"}
        },
        "notes": {"type": ["string", "null"]}
      }
    }
  }
}
